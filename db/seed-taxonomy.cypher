UNWIND [{id:"acm-ccs:2012:10010147",label:"Computing methodologies",tag:"AI & ML"},{id:"acm-ccs:2012:10010147",label:"Computing methodologies",tag:"Computer Graphics"},{id:"acm-ccs:2012:10010147",label:"Computing methodologies",tag:"Model distillation"},{id:"acm-ccs:2012:10010147",label:"Computing methodologies",tag:"Model interpretability"},{id:"acm-ccs:2012:10010147",label:"Computing methodologies",tag:"Prompt caching"},{id:"acm-ccs:2012:10010520",label:"Computer systems organization",tag:"Systems & Hardware"},{id:"acm-ccs:2012:10010520",label:"Computer systems organization",tag:"Kubernetes"},{id:"acm-ccs:2012:10010520",label:"Computer systems organization",tag:"Observability"},{id:"acm-ccs:2012:10011007",label:"Software and its engineering",tag:"Software Engineering"},{id:"acm-ccs:2012:10011007",label:"Software and its engineering",tag:"Coding agents"},{id:"acm-ccs:2012:10011007",label:"Software and its engineering",tag:"Compilers"},{id:"acm-ccs:2012:10011007",label:"Software and its engineering",tag:"Durable execution"},{id:"acm-ccs:2012:10002978",label:"Security and privacy",tag:"Cybersecurity"},{id:"acm-ccs:2012:10002978",label:"Security and privacy",tag:"Digital identity"},{id:"acm-ccs:2012:10002978",label:"Security and privacy",tag:"Privacy"},{id:"acm-ccs:2012:10002978",label:"Security and privacy",tag:"Sandboxing"},{id:"acm-ccs:2012:10002951",label:"Information systems",tag:"Browsers"},{id:"acm-ccs:2012:10003120",label:"Human-centered computing",tag:"Mobile platforms"}] AS row
MERGE (topic:NewsTopic {name: row.tag})
SET topic.concept_id = coalesce(topic.concept_id, 'urn:technical-reading-room:topic:' + toLower(replace(row.tag, ' ', '-'))),
    topic.scheme = coalesce(topic.scheme, 'local')
MERGE (parent:NewsSubject {concept_id: row.id})
SET parent.pref_label = row.label, parent.scheme = 'ACM CCS 2012'
MERGE (topic)-[mapping:BROAD_MATCH]->(parent)
SET mapping.predicate = 'http://www.w3.org/2004/02/skos/core#broadMatch'
RETURN count(*) AS mapped
