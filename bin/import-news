#!/usr/bin/env ruby
require "json"

require_relative "../app/services/import_records"

records = begin
  JSON.parse($stdin.read)
rescue JSON::ParserError
  abort "Expected a JSON array of article records"
end

begin
  count = ImportRecords.new.call(records)
rescue ArgumentError => error
  abort error.message
rescue Archive::Unavailable => error
  abort "The archive is unavailable: #{error.message}"
end

puts "Imported #{count} discovery records"
