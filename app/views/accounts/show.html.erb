<main class="account" aria-labelledby="account-title">
  <small id="edition">Account</small>
  <h1 id="account-title">Your account</h1>
  <p class="account-lede">The details this account signs in with, and the few things it may change.</p>

  <dl class="account-details">
    <div class="account-detail">
      <dt>Email</dt>
      <dd id="account-email"><%= @account.email %></dd>
    </div>
    <div class="account-detail">
      <dt>Role</dt>
      <dd id="account-role"><%= role_label(@account.role) %></dd>
    </div>
    <div class="account-detail">
      <dt>Joined</dt>
      <dd id="account-joined"><%= @account.created_at.strftime("%Y-%m-%d") %></dd>
    </div>
    <div class="account-detail">
      <dt>Last sign-in</dt>
      <dd id="account-last-sign-in"><%= @account.last_sign_in_at ? @account.last_sign_in_at.strftime("%Y-%m-%d %H:%M") : "—" %></dd>
    </div>
    <div class="account-detail">
      <dt>Sign-ins</dt>
      <dd id="account-sign-in-count"><%= @account.sign_in_count %></dd>
    </div>
    <div class="account-detail">
      <dt>Status</dt>
      <dd id="account-status"><%= @account.disabled? ? "disabled" : "active" %></dd>
    </div>
  </dl>

  <p class="account-note">
    The role is set by an administrator and cannot be changed here.
  </p>

  <section class="account-section" id="change-email" aria-labelledby="change-email-title">
    <h2 id="change-email-title">Change email</h2>
    <%= render "form_errors", errors: (@errors if @failed_form == :email_form) %>

    <%= form_with scope: :user, url: account_email_path, method: :patch, local: true,
                  html: { class: "account-form" } do |form| %>
      <%= form.label :email, "New email address" %>
      <%= form.email_field :email, value: @email_value, autocomplete: "email", required: true %>

      <%= form.label :current_password, "Current password" %>
      <%= form.password_field :current_password, autocomplete: "current-password", required: true %>

      <%= form.submit "Update email" %>
    <% end %>
  </section>

  <section class="account-section" id="change-password" aria-labelledby="change-password-title">
    <h2 id="change-password-title">Change password</h2>
    <%= render "form_errors", errors: (@errors if @failed_form == :password_form) %>

    <%= form_with scope: :user, url: account_password_path, method: :patch, local: true,
                  html: { class: "account-form" } do |form| %>
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, autocomplete: "new-password", required: true %>
      <small>At least 8 characters.</small>

      <%= form.label :password_confirmation, "Confirm the new password" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %>

      <%= form.label :current_password, "Current password" %>
      <%= form.password_field :current_password, autocomplete: "current-password", required: true %>

      <%= form.submit "Update password" %>
    <% end %>
  </section>

  <section class="account-section" id="two-factor" aria-labelledby="two-factor-title">
    <h2 id="two-factor-title">Two-factor authentication</h2>
    <p class="account-mfa-status" id="account-mfa-status">
      <% if @account.otp_required_for_login? %>
        On. Signing in asks for your password and a code from your authenticator app.
      <% else %>
        Off. Signing in asks for your password only.
      <% end %>
    </p>

    <% if @account.otp_required_for_login? %>
      <%= render "form_errors", errors: (@errors if @failed_form == :two_factor_disable_form) %>

      <%= form_with scope: :user, url: account_two_factor_path, method: :delete, local: true,
                    html: { class: "account-form" } do |form| %>
        <%= form.label :current_password, "Current password" %>
        <%= form.password_field :current_password, autocomplete: "current-password", required: true %>
        <small>Turning two-factor off needs your password, like the forms above. It also discards the key.</small>

        <%= form.submit "Disable two-factor" %>
      <% end %>
    <% elsif @pending_otp_secret %>
      <p>
        Add this key to your authenticator app (or paste the URI into it), then enter the
        six-digit code it shows. Two-factor stays off until a code matches.
      </p>

      <h3>Key</h3>
      <code class="mfa-key" id="mfa-secret"><%= @pending_otp_secret %></code>

      <h3>Setup URI</h3>
      <code class="mfa-key" id="mfa-provisioning-uri"><%= @otp_provisioning_uri %></code>

      <%= render "form_errors", errors: (@errors if @failed_form == :two_factor_form) %>

      <%= form_with scope: :user, url: account_two_factor_path, method: :patch, local: true,
                    html: { class: "account-form" } do |form| %>
        <%= form.label :otp_attempt, "Six-digit code from the app" %>
        <%= form.text_field :otp_attempt, inputmode: "numeric", autocomplete: "one-time-code",
                            pattern: "[0-9]{6}", maxlength: 6, required: true %>

        <%= form.submit "Turn on two-factor" %>
      <% end %>
    <% else %>
      <p>Once two-factor is on, signing in needs a code from an authenticator app as well as your password.</p>

      <%= form_with url: account_two_factor_path, method: :post, local: true,
                    html: { class: "account-form" } do |form| %>
        <%= form.submit "Set up two-factor" %>
      <% end %>
    <% end %>
  </section>
</main>
