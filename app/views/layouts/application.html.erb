<!doctype html>
<html lang="en" data-theme="night">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#070d1e">
  <title>NewsAgg: Your media aggregator</title>
  <link rel="stylesheet" href="/dashboard.css">
  <script src="/turbo.js" defer></script>
  <script src="/dashboard.js" defer></script>
</head>
<body>
  <%# Every screen carries the bar: the product title on the left, the account
      menu on the right. It works without JavaScript - the menu is a wrapping
      flex row, not a dropdown. %>
  <header class="topbar">
    <div class="topbar-inner">
      <%= link_to "NewsAgg: Your media aggregator", root_path, class: "topbar-title" %>
      <nav class="topbar-account" aria-label="Account">
        <% if user_signed_in? %>
          <span class="account-email"><%= current_user.email %></span>
          <span class="account-role"><%= role_label(current_user.role) %></span>
          <% if route_helper_defined?(:account_path) %>
            <%= link_to "Profile", account_path, class: "account-link" %>
          <% end %>
          <% if (current_user.admin? || current_user.super_admin?) && route_helper_defined?(:admin_root_path) %>
            <%= link_to "Admin console", admin_root_path, class: "account-link" %>
          <% end %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete,
            class: "account-link account-sign-out", form: { class: "account-sign-out-form" } %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "account-link" %>
          <%= link_to "Create account", new_user_registration_path, class: "account-link" %>
        <% end %>
      </nav>
    </div>
  </header>
  <% if flash.any? %>
    <div class="flash" role="status">
      <% flash.each do |type, message| %>
        <p class="flash-<%= type %>"><%= message %></p>
      <% end %>
    </div>
  <% end %>
  <%= yield %>
</body>
</html>
