<main>
  <small id="edition">News archive</small>
  <p id="intro"<% if @archive_error %> class="notice notice-error" role="alert"<% end %>><%= @archive_error || "Browse the archive by subject, publisher, discovery source, or technical depth." %></p>

  <form id="filter-form" method="get" action="/dashboard" data-turbo-frame="dashboard" data-turbo-action="advance"></form>

  <div class="quick-filters" role="search" aria-label="Search the archive">
    <label>Search articles
      <input form="filter-form" id="search" name="q" type="search" value="<%= @filter.params_value(:q) %>"
        placeholder="Search titles, summaries, or tags" data-autosubmit>
    </label>
    <%= render "auto_pull" %>
  </div>
  <p id="auto-pull-error" class="notice notice-error" role="status" hidden></p>

  <p id="update-status" role="status" hidden>
    <button id="apply-update" type="button">New articles available</button>
  </p>

  <turbo-frame id="dashboard">
    <div class="layout">
      <aside class="filter-panel" aria-label="Article filters">
        <details class="filters-disclosure" id="filters-disclosure" data-filters-state-key="newsagg.filters-panel-state" <%= "open" if @filter.active_filter_count.positive? %>>
          <summary class="filters-summary" aria-expanded="<%= @filter.active_filter_count.positive? %>">
            <span class="filters-summary-title">Filters</span>
            <span class="filter-count"><%= @filter.active_filter_count.zero? ? "No filters active" : "#{@filter.active_filter_count} active" %></span>
          </summary>
          <div class="filter-panel-body">
            <h2>Topics</h2>
            <nav aria-label="Topics by subject">
            <div id="topics">
              <%= link_to filter_link(topic: nil, heading: nil, page: nil),
                class: "bar",
                data: { turbo_frame: "dashboard" },
                "aria-pressed" => (@filter.selected_topic.empty? && @filter.selected_heading.empty?).to_s,
                style: "--share: #{share(@filter.all_count)}%" do %>
                <span>All articles</span><span><%= @filter.all_count %></span>
              <% end %>

              <% @filter.topic_tree.each do |group| %>
                <%= link_to filter_link(heading: group[:selected] ? nil : group[:heading], topic: nil, page: nil),
                  class: "bar heading-caption",
                  data: { turbo_frame: "dashboard" },
                  "aria-pressed" => group[:selected].to_s,
                  "aria-expanded" => group[:expanded].to_s,
                  style: "--share: #{share(group[:count])}%" do %>
                  <span><%= group[:heading] %></span><span><%= group[:count] %></span>
                <% end %>
                <% if group[:expanded] %>
                  <% group[:topics].each do |topic| %>
                    <%= link_to filter_link(topic: topic[:selected] ? nil : topic[:name],
                      heading: topic[:selected] ? nil : group[:heading], page: nil),
                      class: "bar topic",
                      data: { turbo_frame: "dashboard" },
                      "aria-pressed" => topic[:selected].to_s,
                      style: "--share: #{share(topic[:count])}%" do %>
                      <span><%= topic[:name] %></span><span><%= topic[:count] %></span>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
            </nav>

            <div class="date-block" id="date-block">
              <h2>Date added</h2>
              <label>Added
                <select form="filter-form" id="date-preset" name="date_preset" data-autosubmit>
                  <% DashboardFilter::DATE_PRESETS.each_key do |value| %>
                    <option value="<%= value %>" <%= "selected" if @filter.params_value(:date_preset) == value %>>
                      <%= DashboardFilter::DATE_PRESET_LABELS.fetch(value) %>
                    </option>
                  <% end %>
                  <option value="" <%= "selected" if @filter.params_value(:date_preset).empty? %>>All time</option>
                </select>
              </label>
              <% custom_open = @filter.custom_range_active? %>
              <details class="custom-range" id="custom-range" <%= "open" if custom_open %>>
                <summary aria-expanded="<%= custom_open %>">Custom range</summary>
                <label>From<input form="filter-form" id="date-from" name="date_from" type="date" value="<%= @filter.params_value(:date_from) %>" data-autosubmit></label>
                <label>Through<input form="filter-form" id="date-through" name="date_through" type="date" value="<%= @filter.params_value(:date_through) %>" data-autosubmit></label>
              </details>
            </div>

            <h2>Refine</h2>
            <label>Published by
              <select form="filter-form" id="publisher" name="publisher" data-autosubmit>
                <option value="">All</option>
                <%= options_for_select(@filter.options("publisher").map { |value| [value, value] }, @filter.value("publisher")) %>
              </select>
            </label>
            <label>Discovered via
              <select form="filter-form" id="source" name="source" data-autosubmit>
                <option value="">All</option>
                <%= options_for_select(@filter.options("source").map { |value| [value, value] }, @filter.value("source")) %>
              </select>
            </label>
            <label>Technical depth
              <select form="filter-form" id="depth" name="depth" data-autosubmit>
                <option value="">All</option>
                <%= options_for_select(@filter.options("depth").map { |value| [value, value] }, @filter.value("depth")) %>
              </select>
            </label>
            <p class="clear-filters"><%= link_to "Clear filters", filter_link(topic: nil, heading: nil, q: nil, date_preset: nil,
              date_from: nil, date_through: nil, published_from: nil, published_through: nil,
              publisher: nil, source: nil, depth: nil, page: nil), data: { turbo_frame: "dashboard" } %></p>
          </div>
        </details>
      </aside>

      <section class="results" aria-labelledby="count">
        <h2 id="count" aria-live="polite" tabindex="-1"><%= @filter.count_text %></h2>
        <p class="page-indicator" id="page-indicator">Page <%= @filter.page %> of <%= @filter.page_count %></p>
        <div id="articles">
          <%= render partial: "article", collection: @filter.page_articles, as: :article %>
          <% if @filter.visible.empty? %>
            <div class="empty-state" role="status">
              <h3>No articles match these filters.</h3>
              <p>Try a broader search, a different date range, or another topic.</p>
              <p><%= link_to "Clear filters", filter_link(topic: nil, heading: nil, q: nil, date_preset: nil,
                date_from: nil, date_through: nil, published_from: nil, published_through: nil,
                publisher: nil, source: nil, depth: nil, page: nil), data: { turbo_frame: "dashboard" } %></p>
            </div>
          <% end %>
        </div>

        <% if @filter.page_count > 1 %>
          <nav class="pagination" aria-label="Article pages">
            <% if @filter.page > 1 %>
              <%= link_to "Previous", filter_link(page: @filter.page - 1), rel: "prev",
                class: "pagination-link", data: { turbo_frame: "dashboard", turbo_action: "advance" } %>
            <% else %>
              <span class="pagination-link is-disabled" aria-disabled="true">Previous</span>
            <% end %>

            <% (1..@filter.page_count).each do |number| %>
              <% if number == @filter.page %>
                <span class="pagination-link is-current" aria-current="page"><%= number %></span>
              <% else %>
                <%= link_to number, filter_link(page: number), class: "pagination-link",
                  data: { turbo_frame: "dashboard", turbo_action: "advance" } %>
              <% end %>
            <% end %>

            <% if @filter.page < @filter.page_count %>
              <%= link_to "Next", filter_link(page: @filter.page + 1), rel: "next",
                class: "pagination-link", data: { turbo_frame: "dashboard", turbo_action: "advance" } %>
            <% else %>
              <span class="pagination-link is-disabled" aria-disabled="true">Next</span>
            <% end %>
          </nav>
        <% end %>
      </section>
    </div>

    <%= render "version", version: @version %>
  </turbo-frame>
</main>
