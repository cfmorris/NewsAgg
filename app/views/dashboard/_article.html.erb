<article>
  <small><%= [article["publisher"], article["depth"],
    article["published_date"] ? "Published #{article["published_date"]}" : "Publication date unknown",
    article["archive_date"] && "Added #{article["archive_date"]}"].compact.reject(&:empty?).join(" · ") %></small>
  <h3><%= article["title"] %></h3>
  <p><%= article["summary"] %></p>
  <div class="tags">
    <% Array(article["topics"]).each do |topic| %>
      <%= link_to topic, filter_link(topic: topic, heading: nil),
        class: "tag", data: { turbo_frame: "dashboard" },
        "aria-pressed" => (@filter.selected_topic == topic).to_s %>
    <% end %>
  </div>
  <%= link_to "Original", article["url"] %>
  <% Array(article["discoveries"]).each do |discovery| %>
    · <%= link_to(discovery["source"] == "Hacker News" ? "HN discussion" : discovery["source"], discovery["url"]) %>
  <% end %>
</article>
