<article>
  <small class="article-meta">
    <% meta = [article["publisher"], article["depth"],
      article["published_date"] ? "Published #{article["published_date"]}" : "Publication date unknown",
      article["archive_date"] && "Added #{article["archive_date"]}"].compact.reject(&:empty?) %>
    <% meta.each do |item| %><span><%= item %></span><% end %>
  </small>
  <% topics = Array(article["topics"]).reject { |topic| topic.to_s.empty? } %>
  <h3 class="article-title" aria-label="<%= article["title"] %>">
    <span class="article-title-text"><%= article["title"] %></span>
    <% unless topics.empty? %>
      <span class="tags">
        <% topics.each do |topic| %>
          <%= link_to topic, filter_link(topic: @filter.selected_topic == topic ? nil : topic, heading: nil),
            class: "tag", data: { turbo_frame: "dashboard" },
            "aria-pressed" => (@filter.selected_topic == topic).to_s %>
        <% end %>
      </span>
    <% end %>
  </h3>
  <p><%= article["summary"] %><% if article["url"] %> · <%= link_to "Original", article["url"] %><% end %><% Array(article["discoveries"]).each do |discovery| %> · <%= link_to(discovery["source"] == "Hacker News" ? "HN discussion" : discovery["source"], discovery["url"]) %><% end %></p>
  <% if article["url"] %>
    <div class="article-actions">
      <% if hidden_view %>
        <%= button_to "Unhide", unhide_article_path, method: :delete,
          params: { url: article["url"] },
          class: "article-action", form_class: "article-action-form",
          form: { "aria-label" => "Unhide #{article["title"]}" } %>
      <% else %>
        <%= button_to "Hide", hide_article_path,
          params: { url: article["url"] },
          class: "article-action", form_class: "article-action-form",
          form: { "aria-label" => "Hide #{article["title"]}" } %>
      <% end %>
    </div>
  <% end %>
</article>
