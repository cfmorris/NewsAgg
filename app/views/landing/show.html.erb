<%# A deep link to sign-in arrives here as /?auth=sign-in. Naming the card on
    the page keeps the choice server-side, so dashboard.js only has to open the
    link with that name; without JavaScript the page still offers both links. %>
<main class="landing" aria-labelledby="landing-title"<% if params[:auth].present? %> data-auth-autoload="<%= params[:auth] %>"<% end %>>
  <small id="edition">News aggregator</small>
  <h1 id="landing-title">NewsAgg: Your media aggregator</h1>
  <p class="landing-lede">Browse the archive by subject, publisher, discovery source, or technical depth.</p>

  <% if user_signed_in? %>
    <p class="landing-actions">
      <%= link_to "Go to dashboard", dashboard_path, class: "landing-action" %>
    </p>
  <% else %>
    <%# Both calls to action are ordinary links: without JavaScript they navigate
        to the Devise screens, and dashboard.js upgrades them to open the
        floating overlay instead. Each link names the embedded source its frame
        loads. %>
    <p class="landing-actions">
      <%= link_to "Sign in", new_user_session_path, class: "landing-action",
        aria: { haspopup: "dialog" },
        data: { auth_overlay: "sign-in", auth_overlay_src: "#{new_user_session_path}?embedded=1" } %>
      <%= link_to "Create account", new_user_registration_path, class: "landing-action",
        aria: { haspopup: "dialog" },
        data: { auth_overlay: "sign-up", auth_overlay_src: "#{new_user_registration_path}?embedded=1" } %>
    </p>
    <%= render "landing/auth_overlay" %>
  <% end %>
</main>
